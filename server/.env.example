PORT=5001
NODE_ENV=development

# Database Configuration
# Local MongoDB: mongodb://localhost:27017/project_management
# Atlas MongoDB: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/project_management

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:3000
