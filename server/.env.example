PORT=5001
NODE_ENV=development
# MongoDB URI (use Docker auth credentials or standalone local/Atlas URI)
MONGODB_URI=mongodb://admin:password123@localhost:27017/project_management?authSource=admin
# Standalone local without auth: mongodb://localhost:27017/project_management
# Atlas cloud: mongodb+srv://<user>:<password>@cluster0.mongodb.net/project_management
JWT_SECRET=supersecretjwtkey_change_in_production_123456
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
